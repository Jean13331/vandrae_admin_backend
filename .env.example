PORT=3333
NODE_ENV=development

# Origem do frontend admin (Vite)
CORS_ORIGIN=https://localhost:5173

# JWT
JWT_SECRET=troque-esta-chave-em-producao
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# HTTPS local (true gera certificado em ./certs)
HTTPS=true
# Porta HTTP extra para o Expo Go na mesma Wi-Fi (o celular não aceita o certificado local)
MOBILE_HTTP_PORT=3147
# HTTPS_KEY=./certs/localhost-key.pem
# HTTPS_CERT=./certs/localhost-cert.pem

# Administrador inicial (inserido no banco se o e-mail ainda não existir)
ADMIN_SEED_ID=admin-1
ADMIN_SEED_NAME=Administrador
ADMIN_SEED_EMAIL=admin@vandrae.com
ADMIN_SEED_PASSWORD=vandrae-admin
# E-mails com acesso ao painel (além do ADMIN_SEED_EMAIL). Separe por vírgula.
ADMIN_ALLOWED_EMAILS=

# Client IDs OAuth do Google (o Web é obrigatório; Android/iOS se existirem). Separe por vírgula.
# Use o mesmo Client ID Web do EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID.
GOOGLE_CLIENT_IDS=
# Chave secreta do mesmo Client tipo Web (só no backend). Troca o code do Expo Go pelo id_token.
GOOGLE_CLIENT_SECRET=

# PostgreSQL — preencha DATABASE_URL ou os campos separados
# URL no formato Node: postgresql://USER:PASSWORD@HOST:5432/DB
DATABASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=vandrae
# true para bancos remotos (Render, Neon, etc.)
DB_SSL=false
